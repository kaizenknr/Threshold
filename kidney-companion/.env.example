# =========================================================================
# Kidney Companion — environment template. Copy to .env and fill real values.
# Real .env files are gitignored. Set production values in Vercel Project Env
# (api + web) and EAS secrets / app config (mobile, PUBLIC values only).
# =========================================================================

# ---- Server API only (NEVER exposed to any client bundle) ---------------
ANTHROPIC_API_KEY=sk-ant-xxx
SUPABASE_SERVICE_ROLE_KEY=xxx
SUPABASE_URL=https://xxx.supabase.co
# Comma-separated CORS allowlist for the Server API
API_ALLOWED_ORIGINS=http://localhost:3000,https://app.kidneycompanion.com,https://kidneycompanion.com
# The current Terms/consent version an AI request must have accepted
CONSENT_TERMS_VERSION=2026-07-01
# Optional: Upstash Redis REST for cross-instance rate limiting (serverless).
# Leave blank to use the in-memory limiter (single instance only).
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=

# ---- Safe for clients (public by design; protected by RLS) --------------
# Next.js (web)
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787/v1
# Must match the server's CONSENT_TERMS_VERSION so the consent gate lines up.
NEXT_PUBLIC_CONSENT_TERMS_VERSION=2026-07-01

# Expo (mobile) — same values, EXPO_PUBLIC_ prefix
EXPO_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=xxx
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787/v1
EXPO_PUBLIC_CONSENT_TERMS_VERSION=2026-07-01
